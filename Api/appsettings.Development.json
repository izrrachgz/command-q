{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "commandq-api",
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    },
    "Migrations": {
      "RunOnStartup": true
    },
    "HealthCheck": {
      "RunOnStartup": false,
      "FailStartupOnUnhealthy": false,
      "PublishReports": false
    },
    "IdentityServerAdmin": {
      "Enabled": true,
      "BaseUrl": "https://localhost:7125/",
      "ApiKeyHeaderName": "X-CommandQ-Identity-Admin-Key",
      "ApiKey": "local-development-identity-admin-key"
    },
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": [
        "http://localhost:4200",
        "http://localhost:4201",
        "http://localhost:4202",
        "http://localhost:4203",
        "http://localhost:4204",
        "http://localhost:4205",
        "http://127.0.0.1:4200",
        "http://127.0.0.1:4201",
        "http://127.0.0.1:4202",
        "http://127.0.0.1:4203",
        "http://127.0.0.1:4204",
        "http://127.0.0.1:4205"
      ]
    },
    "ApiClients": [
      {
        "Name": "location_family",
        "Id": "find_me",
        "Uri": "http://localhost:4200"
      }
    ],
    "EmailOutbox": {
      "Persistence": {
        "Engine": "",
        "ConnectionString": ""
      }
    }
  }
}
