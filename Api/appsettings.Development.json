{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "commandq-api",
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    },
    "Migrations": {
      "RunOnStartup": true
    },
    "HealthCheck": {
      "RunOnStartup": false,
      "FailStartupOnUnhealthy": false,
      "PublishReports": false
    },
    "EmailOutbox": {
      "Persistence": {
        "Engine": "",
        "ConnectionString": ""
      }
    }
  }
}
