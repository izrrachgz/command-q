{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 16,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Api": {
    "Features": {},
    "ExternalApiClients": {
      "Clients": {}
    },
    "Localization": {
      "DefaultCulture": "en-US",
      "FallbackCulture": "en-US",
      "SupportedCultures": [ "en-US", "es-ES" ],
      "JsonLocalesPath": "locales",
      "ProviderOrder": [ "Json", "Resx" ]
    },
    "Authentication": {
      "Authority": "https://localhost:7125/",
      "Audience": "command_q_api",
      "ApiScope": "command_q_api",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 60
    },
    "RateLimiting": {
      "Type": "FixedWindow",
      "FixedWindow": {
        "PermitLimit": 8,
        "WindowSeconds": 16,
        "QueueLimit": 2
      },
      "Sliding": {
        "PermitLimit": 100,
        "WindowSeconds": 16,
        "QueueLimit": 8,
        "SegmentsPerWindow": 4
      },
      "TokenBucket": {
        "PermitLimit": 4,
        "WindowSeconds": 16,
        "QueueLimit": 2,
        "TokensPerPeriod": 4
      },
      "Concurrency": {
        "PermitLimit": 4,
        "WindowSeconds": 16,
        "QueueLimit": 2
      }
    },
    "ConnectionStrings": {
      "Db": "",
      "Engine": "MsSql"
      //MsSql   expected format "Server=<redacted>",
      //PgSql   expected format "Host=<redacted>"
      //MySql   expected format "Server=<redacted>",
      //SqLite  expected format "Data Source=<redacted>",
    },
    "Migrations": {
      "RunOnStartup": true
    },
    "EmailOutbox": {
      "Persistence": {
        "Engine": "MsSql",
        "ConnectionString": ""
        //MsSql   expected format "Server=<redacted>",
        //PgSql   expected format "Host=<redacted>"
        //MySql   expected format "Server=<redacted>",
        //SqLite  expected format "Data Source=<redacted>",
      }
    },
    "ApiClients": [
      {
        "Name": "",
        "Id": "",
        "Uri": ""
      }
    ],
    "HealthCheck": {
      "UrlCheckInternetAccess": "https://www.google.com/",
      "PublishOnStartup": false,
      "PublishIntervalSeconds": 86400
    },
    "CacheSettings": {
      "MaxAgeSeconds": 10
    }
  }
}
