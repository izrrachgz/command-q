{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 16,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Api": {
    "Application": {
      "TimeZone": "America/Hermosillo"
    },
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "command-q-api",
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    },
    "Features": {},
    "ExternalApiClients": {
      "Clients": {}
    },
    "Localization": {
      "DefaultCulture": "en-US",
      "FallbackCulture": "en-US",
      "SupportedCultures": [ "en-US", "es-ES" ],
      "JsonLocalesPath": "locales",
      "ProviderOrder": [ "Json", "Resx" ]
    },
    "Authentication": {
      "Authority": "https://localhost:7125/",
      "Audience": "command-q_api",
      "ApiScope": "command-q_api",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 60
    },
    "IdentityServerAdmin": {
      "Enabled": false,
      "BaseUrl": "https://localhost:7125/",
      "ApiKeyHeaderName": "X-command-q-Identity-Admin-Key",
      "ApiKey": "",
      "TimeoutSeconds": 15,
      "UsersPath": "internal/account-admin/users",
      "RolesPath": "internal/account-admin/roles"
    },
    "Cors": {
      "Enabled": false,
      "AllowedOrigins": []
    },
    "RateLimiting": {
      "Type": "TokenBucket",
      "FixedWindow": {
        "PermitLimit": 6,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Sliding": {
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "QueueLimit": 4,
        "SegmentsPerWindow": 6
      },
      "TokenBucket": {
        "WindowSeconds": 10,
        "QueueLimit": 8,
        "TokenLimit": 40,
        "TokensPerPeriod": 20
      },
      "Concurrency": {
        "PermitLimit": 4,
        "QueueLimit": 4
      }
    },
    "ConnectionStrings": {
      "Db": "",
      "Engine": "PgSql"
      //MsSql   expected format "Server=<redacted>",
      //PgSql   expected format "Host=<redacted>"
      //MySql   expected format "Server=<redacted>",
      //SqLite  expected format "Data Source=<redacted>",
    },
    "Migrations": {
      "RunOnStartup": true
    },
    "EmailApiClient": {
      "Enabled": false,
      "BaseUrl": "https://localhost:7325",
      "ApiClientHeaderName": "",
      "ApiClientKey": "",
      "UserName": "",
      "Password": "",
      "TimeoutSeconds": 30
    },
    "ApiClients": [
      {
        "Name": "",
        "Id": "",
        "Uri": ""
      }
    ],
    "HealthCheck": {
      "UrlCheckInternetAccess": "https://www.google.com/",
      "RunOnStartup": false,
      "FailStartupOnUnhealthy": false,
      "PublishReports": false,
      "PublishIntervalSeconds": 86400
    },
    "CacheSettings": {
      "MaxAgeSeconds": 10
    }
  }
}
