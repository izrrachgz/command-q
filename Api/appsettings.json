{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Language": "English",
    "Jwt": {
        "SecretKey": "",
        "MinutesToExpire": 30,
        "Issuer": "localhost",
        "Audience": "localhost",
        "AccessTokenMinutes": 15,
        "RefreshTokenDays": 7
    },
    "RateLimiting": {
        "Type": "FixedWindow",
        "FixedWindow": {
            "PermitLimit": 4,
            "WindowSeconds": 16,
            "QueueLimit": 2
        },
        "Sliding": {
            "PermitLimit": 100,
            "WindowSeconds": 16,
            "QueueLimit": 8,
            "SegmentsPerWindow": 4
        },
        "TokenBucket": {
            "PermitLimit": 4,
            "WindowSeconds": 16,
            "QueueLimit": 2,
            "TokensPerPeriod": 4
        },
        "Concurrency": {
            "PermitLimit": 4,
            "WindowSeconds": 16,
            "QueueLimit": 2
        }
    },
    "ConnectionStrings": {
        "Db": "",
        "Engine": "MsSql"
        //MsSql     excpected format "Server=<redacted>",
        //PgSql   excpected format "Host=<redacted>"
        //MySql   excpected format "Server=<redacted>",
        //SqLite  excpected format "Data Source=<redacted>",
    },
    "ApiAccessKeys": {
        "Key": "",
        "Value": ""
    },
    "HealthCheck": {
        "UrlCheckInternetAccess": "https://www.google.com/"
    },
    "CacheSettings": {
        "MaxAgeSeconds": 10
    }
}
