{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "command-q-api",
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    },
    "Authentication": {
      "Authority": "",
      "Audience": "command-q_api",
      "ApiScope": "command-q_api",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 60
    },
    "ConnectionStrings": {
      "Db": "",
      "Engine": ""
    },
    "Migrations": {
      "RunOnStartup": false
    },
    "EmailApiClient": {
      "Enabled": false
    },
    "ApiClients": [
      {
        "Name": "",
        "Id": "",
        "Uri": ""
      }
    ],
    "HealthCheck": {
      "UrlCheckInternetAccess": "https://www.google.com/",
      "RunOnStartup": false,
      "FailStartupOnUnhealthy": false,
      "PublishReports": false
    }
  }
}
