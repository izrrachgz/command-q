{
  "name": "front-application",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node tools/start-dev.mjs",
    "start:angular": "ng serve --configuration development",
    "log:development": "node tools/dev-log-server.mjs",
    "start:testing": "ng serve --configuration testing",
    "start:staging": "ng serve --configuration staging",
    "start:production": "ng serve --configuration production",
    "build": "ng build --configuration development",
    "build:development": "ng build --configuration development",
    "build:testing": "ng build --configuration testing",
    "build:staging": "ng build --configuration staging",
    "build:production": "ng build --configuration production",
    "build:release": "ng build --configuration production && node tools/compress-dist.mjs dist/FrontApplication/browser",
    "build:release:obfuscated": "ng build --configuration production && node tools/obfuscate-dist.mjs dist/FrontApplication/browser && node tools/compress-dist.mjs dist/FrontApplication/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@fontsource/roboto": "^5.3.0",
    "@lucide/angular": "^1.31.0",
    "angular-auth-oidc-client": "^21.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@tailwindcss/postcss": "^4.3.3",
    "javascript-obfuscator": "^5.5.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
