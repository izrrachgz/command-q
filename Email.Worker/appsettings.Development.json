{
  "EmailWorker": {
    "Email": {
      "Enabled": true,
      "Smtp": {
        "Host": "localhost",
        "Port": 25,
        "Security": "None",
        "TimeoutMilliseconds": 100000,
        "CheckCertificateRevocation": false
      },
      "Authentication": {
        "Type": "Anonymous"
      },
      "Sender": {
        "Address": "no-reply@commandq.local",
        "Name": "CommandQ"
      }
    },
    "Worker": {
      "Enabled": true
    },
    "EmailOutbox": {
      "Persistence": {
        "Engine": "MsSql",
        "ConnectionString": ""
      }
    },
    "Migrations": {
      "RunOnStartup": true
    }
  }
}
