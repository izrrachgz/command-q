{
  "EmailWorker": {
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "command-q-email-worker",
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    },
    "Email": {
      "Enabled": true,
      "DefaultProfile": "default",
      "Profiles": {
        "default": {
          "Enabled": true,
          "Smtp": {
            "Host": "localhost",
            "Port": 25,
            "Security": "None",
            "TimeoutMilliseconds": 100000,
            "CheckCertificateRevocation": false
          },
          "Authentication": {
            "Type": "Anonymous"
          },
          "Sender": {
            "Address": "no-reply@command-q.local",
            "Name": "command-q"
          }
        }
      }
    },
    "Worker": {
      "Enabled": true
    },
    "EmailOutbox": {
      "Persistence": {
        "Engine": "MsSql",
        "ConnectionString": ""
      }
    },
    "Migrations": {
      "RunOnStartup": true
    }
  }
}
