{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EmailWorker": {
    "Email": {
      "Enabled": false,
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Security": "StartTls",
        "TimeoutMilliseconds": 100000,
        "CheckCertificateRevocation": true
      },
      "Authentication": {
        "Type": "Anonymous",
        "Login": {
          "Username": "",
          "Password": ""
        },
        "Plain": {
          "Username": "",
          "Password": ""
        },
        "OAuth": {
          "Username": "",
          "AccessToken": ""
        }
      },
      "Sender": {
        "Address": "",
        "Name": ""
      }
    },
    "EmailOutbox": {
      "MaxAttempts": 5,
      "BaseRetryDelaySeconds": 30,
      "MaxRetryDelaySeconds": 3600,
      "MaxErrorLength": 2000,
      "MaxPayloadBytes": 67108864,
      "Persistence": {
        "Engine": "MsSql",
        "ConnectionString": ""
        //MsSql   expected format "Server=<redacted>",
        //PgSql   expected format "Host=<redacted>"
        //MySql   expected format "Server=<redacted>",
        //SqLite  expected format "Data Source=<redacted>",
      }
    },
    "Worker": {
      "Enabled": false,
      "BatchSize": 10,
      "PollIntervalSeconds": 5,
      "LeaseSeconds": 1800,
      "ErrorDelaySeconds": 30
    },
    "Migrations": {
      "RunOnStartup": false
    }
  }
}
