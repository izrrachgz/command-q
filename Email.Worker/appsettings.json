{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 16,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "EmailWorker": {
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "commandq-email-worker",
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    },
    "Email": {
      "Enabled": false,
      "DefaultProfile": "default",
      "Profiles": {
        "default": {
          "Enabled": true,
          "Smtp": {
            "Host": "",
            "Port": 587,
            "Security": "StartTls",
            "TimeoutMilliseconds": 100000,
            "CheckCertificateRevocation": true
          },
          "Authentication": {
            "Type": "Anonymous",
            "Login": {
              "Username": "",
              "Password": ""
            },
            "Plain": {
              "Username": "",
              "Password": ""
            },
            "OAuth": {
              "Username": "",
              "AccessToken": ""
            }
          },
          "Sender": {
            "Address": "",
            "Name": ""
          },
          "DeliveryPolicy": {
            "MaxRecipients": 100,
            "MaxAttachmentCount": 20,
            "MaxAttachmentBytes": 26214400,
            "MaxTotalAttachmentBytes": 41943040,
            "MaxMessageBytes": 67108864,
            "AllowedAttachmentContentTypes": [],
            "AllowedAttachmentExtensions": [],
            "AllowUnknownContentTypes": false,
            "AllowedSenderDomains": []
          }
        }
      }
    },
    "EmailOutbox": {
      "MaxAttempts": 5,
      "BaseRetryDelaySeconds": 30,
      "MaxRetryDelaySeconds": 3600,
      "MaxErrorLength": 2000,
      "MaxPayloadBytes": 67108864,
      "DeliveryPolicy": {
        "MaxRecipients": 100,
        "MaxAttachmentCount": 20,
        "MaxAttachmentBytes": 26214400,
        "MaxTotalAttachmentBytes": 41943040,
        "MaxMessageBytes": 67108864,
        "AllowedAttachmentContentTypes": [],
        "AllowedAttachmentExtensions": [],
        "AllowUnknownContentTypes": false,
        "AllowedSenderDomains": []
      },
      "Persistence": {
        "Engine": "MsSql",
        "ConnectionString": ""
        //MsSql   expected format "Server=<redacted>",
        //PgSql   expected format "Host=<redacted>"
        //MySql   expected format "Server=<redacted>",
        //SqLite  expected format "Data Source=<redacted>",
      }
    },
    "Worker": {
      "Enabled": false,
      "BatchSize": 10,
      "PollIntervalSeconds": 5,
      "LeaseSeconds": 1800,
      "ErrorDelaySeconds": 30
    },
    "Migrations": {
      "RunOnStartup": false
    }
  }
}
