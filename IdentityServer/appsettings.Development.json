{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServer": {
    "ConnectionStrings": {
      "Engine": "MsSql",
      "IdentityDb": ""
    },
    "OpenIddict": {
      "Issuer": "https://localhost:7125/",
      "ApiScope": "command_q_api",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14,
      "Clients": [
        {
          "ClientId": "command_q_local",
          "DisplayName": "CommandQ local development client",
          "ClientSecret": "",
          "AllowClientCredentials": false,
          "RedirectUris": [
            "https://oauth.pstmn.io/v1/callback"
          ],
          "PostLogoutRedirectUris": [
            "https://oauth.pstmn.io/v1/browser-callback"
          ]
        }
      ],
      "Certificates": {
        "UseDevelopmentCertificates": true,
        "Signing": {
          "Path": "",
          "Password": ""
        },
        "Encryption": {
          "Path": "",
          "Password": ""
        }
      }
    },
    "Migrations": {
      "RunOnStartup": true
    }
  }
}
