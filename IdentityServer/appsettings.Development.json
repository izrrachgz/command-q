{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServer": {
    "ConnectionStrings": {
      "Engine": "MsSql",
      "IdentityDb": ""
    },
    "Cors": {
      "Enabled": true,
      "AllowedOrigins": [
        "http://localhost:4200",
        "http://localhost:4201",
        "http://localhost:4202",
        "http://localhost:4203",
        "http://localhost:4204",
        "http://localhost:4205",
        "http://127.0.0.1:4200",
        "http://127.0.0.1:4201",
        "http://127.0.0.1:4202",
        "http://127.0.0.1:4203",
        "http://127.0.0.1:4204",
        "http://127.0.0.1:4205"
      ]
    },
    "AdminApi": {
      "Enabled": true,
      "ApiKeyHeaderName": "X-CommandQ-Identity-Admin-Key",
      "ApiKey": "local-development-identity-admin-key"
    },
    "OpenIddict": {
      "Issuer": "https://localhost:7125/",
      "ApiScope": "command_q_api",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14,
      "Clients": [
        {
          "ClientId": "command_q_local",
          "DisplayName": "CommandQ local development client",
          "ClientSecret": "",
          "AllowClientCredentials": false,
          "RedirectUris": [
            "https://oauth.pstmn.io/v1/callback"
          ],
          "PostLogoutRedirectUris": [
            "https://oauth.pstmn.io/v1/browser-callback"
          ]
        },
        {
          "ClientId": "command_q_spa",
          "DisplayName": "CommandQ local Angular client",
          "ClientSecret": "",
          "AllowClientCredentials": false,
          "RedirectUris": [
            "http://localhost:4200/auth/callback",
            "http://localhost:4201/auth/callback",
            "http://localhost:4202/auth/callback",
            "http://localhost:4203/auth/callback",
            "http://localhost:4204/auth/callback",
            "http://localhost:4205/auth/callback",
            "http://127.0.0.1:4200/auth/callback",
            "http://127.0.0.1:4201/auth/callback",
            "http://127.0.0.1:4202/auth/callback",
            "http://127.0.0.1:4203/auth/callback",
            "http://127.0.0.1:4204/auth/callback",
            "http://127.0.0.1:4205/auth/callback"
          ],
          "PostLogoutRedirectUris": [
            "http://localhost:4200/",
            "http://localhost:4201/",
            "http://localhost:4202/",
            "http://localhost:4203/",
            "http://localhost:4204/",
            "http://localhost:4205/",
            "http://127.0.0.1:4200/",
            "http://127.0.0.1:4201/",
            "http://127.0.0.1:4202/",
            "http://127.0.0.1:4203/",
            "http://127.0.0.1:4204/",
            "http://127.0.0.1:4205/"
          ]
        }
      ],
      "Certificates": {
        "UseDevelopmentCertificates": true,
        "Signing": {
          "Path": "",
          "Password": ""
        },
        "Encryption": {
          "Path": "",
          "Password": ""
        }
      }
    },
    "Migrations": {
      "RunOnStartup": true
    }
  }
}
