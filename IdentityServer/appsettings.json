{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/identity-server-log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 16,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "ConnectionStrings": {
      "Engine": "MsSql",
      "IdentityDb": ""
      //MsSql   expected format "Server=<redacted>",
      //PgSql   expected format "Host=<redacted>"
      //MySql   expected format "Server=<redacted>",
      //SqLite  expected format "Data Source=<redacted>",
    },
    "Identity": {
      "RequiredPasswordLength": 12,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "RequireConfirmedEmail": false,
      "CookieHours": 8,
      "CookieName": "CommandQ.Identity",
      "AuthenticationPermitLimit": 5,
      "AuthenticationWindowSeconds": 60,
      "AuthenticationQueueLimit": 0
    },
    "ExternalProviders": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "DataProtection": {
      "ApplicationName": "CommandQ.IdentityServer",
      "KeysPath": "",
      "Certificate": {
        "Path": "",
        "Password": ""
      }
    },
    "OpenIddict": {
      "Issuer": "",
      "ApiScope": "command_q_api",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14,
      "Clients": [],
      "Certificates": {
        "UseDevelopmentCertificates": false,
        "Signing": {
          "Path": "",
          "Password": ""
        },
        "Encryption": {
          "Path": "",
          "Password": ""
        }
      }
    },
    "Migrations": {
      "RunOnStartup": false
    }
  }
}
