{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/identity-server-log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 16,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "ConnectionStrings": {
      "Engine": "PgSql",
      "IdentityDb": ""
      //MsSql   expected format "Server=<redacted>",
      //PgSql   expected format "Host=<redacted>"
      //MySql   expected format "Server=<redacted>",
      //SqLite  expected format "Data Source=<redacted>",
    },
    "Identity": {
      "RequiredPasswordLength": 12,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "RequireConfirmedEmail": true,
      "CookieHours": 8,
      "CookieName": "command-q.Identity"
    },
    "RateLimiting": {
      "Enabled": true,
      "Authentication": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "Challenges": {
        "PermitLimit": 30,
        "WindowSeconds": 300,
        "SegmentsPerWindow": 10,
        "QueueLimit": 0
      },
      "Default": {
        "TokenLimit": 120,
        "TokensPerPeriod": 60,
        "ReplenishmentPeriodSeconds": 10,
        "QueueLimit": 12
      },
      "Administration": {
        "PermitLimit": 120,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "QueueLimit": 4
      }
    },
    "AccountEmail": {
      "ApplicationBaseUrl": "",
      "ProfileName": "default",
      "ConfirmationLifetimeMinutes": 1440,
      "PasswordRecoveryLifetimeMinutes": 15,
      "ResetGrantLifetimeMinutes": 15,
      "VerificationMaxFailedAttempts": 3,
      "PasswordResetMaxFailedAttempts": 3,
      "ResendCooldownSeconds": 60,
      "DailyDeliveryLimit": 5,
      "DispatchPollSeconds": 5,
      "DispatchBatchSize": 10,
      "DispatchRetryBaseSeconds": 15,
      "DispatchRetryMaxMinutes": 60,
      "CleanupIntervalMinutes": 60,
      "ChallengeRetentionDays": 30,
      "SecurityEventRetentionDays": 90
    },
    "EmailApiClient": {
      "Enabled": false,
      "BaseUrl": "https://localhost:7325",
      "ApiClientHeaderName": "",
      "ApiClientKey": "",
      "UserName": "",
      "Password": "",
      "TimeoutSeconds": 30
    },
    "ExternalProviders": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "AdminApi": {
      "Enabled": false,
      "ApiKeyHeaderName": "X-command-q-Identity-Admin-Key",
      "ApiKey": ""
    },
    "Cors": {
      "Enabled": false,
      "AllowedOrigins": []
    },
    "DataProtection": {
      "ApplicationName": "command-q.IdentityServer",
      "KeysPath": "",
      "Certificate": {
        "Path": "",
        "Password": ""
      }
    },
    "OpenIddict": {
      "Issuer": "",
      "ApiScope": "command-q_api",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 14,
      "Clients": [],
      "Certificates": {
        "UseDevelopmentCertificates": false,
        "Signing": {
          "Path": "",
          "Password": ""
        },
        "Encryption": {
          "Path": "",
          "Password": ""
        }
      }
    },
    "Migrations": {
      "RunOnStartup": false
    }
  }
}
