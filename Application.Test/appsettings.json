{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console", "Serilog.Sinks.Debug" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "Enrich": [ "FromLogContext" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "rollOnFileSizeLimit": true,
                    "fileSizeLimitBytes": 10485760, // 10 MB
                    "retainedFileCountLimit": 16,
                    "shared": true,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "Debug",
                "Args": {
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "Language": "English",
    "ConnectionStrings": {
        "Db": "",
        "Engine": "MsSql"
        //MsSql   excpected format "Server=<redacted>",
        //PgSql   excpected format "Host=<redacted>"
        //MySql   excpected format "Server=<redacted>",
        //SqLite  excpected format "Data Source=<redacted>",
    },
    "ApiClients": [
        {
            "Name": "",
            "Id": "",
            "Uri": ""
        }
    ],
    "HealthCheck": {
        "UrlCheckInternetAccess": "https://www.google.com/"
    },
    "CacheSettings": {
        "MaxAgeSeconds": 10
    }
}
