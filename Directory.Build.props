<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Common' or '$(MSBuildProjectName)' == 'Cqrs' or '$(MSBuildProjectName)' == 'Localization' or '$(MSBuildProjectName)' == 'Persistence' or '$(MSBuildProjectName)' == 'Time'">
    <IsPackable>true</IsPackable>
    <PackageId>CommandQ.$(MSBuildProjectName)</PackageId>
    <Version>0.1.0</Version>
    <Authors>CommandQ</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/izrrachgz/command-q</RepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\command-q-build-output</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Common' or '$(MSBuildProjectName)' == 'Cqrs' or '$(MSBuildProjectName)' == 'Localization' or '$(MSBuildProjectName)' == 'Persistence' or '$(MSBuildProjectName)' == 'Time'">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
