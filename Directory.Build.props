<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Common' or '$(MSBuildProjectName)' == 'Cqrs' or '$(MSBuildProjectName)' == 'Localization' or '$(MSBuildProjectName)' == 'Persistence' or '$(MSBuildProjectName)' == 'Time'">
    <IsPackable>true</IsPackable>
    <PackageId>CommandQ.$(MSBuildProjectName)</PackageId>
    <Version>0.3.4</Version>
    <Authors>CommandQ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/izrrachgz/command-q</PackageProjectUrl>
    <PackageTags>commandq;dotnet;libraries;$(MSBuildProjectName)</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/izrrachgz/command-q</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\command-q-build-output</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Common' or '$(MSBuildProjectName)' == 'Cqrs' or '$(MSBuildProjectName)' == 'Localization' or '$(MSBuildProjectName)' == 'Persistence' or '$(MSBuildProjectName)' == 'Time'">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
