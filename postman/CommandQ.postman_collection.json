    {
      "name": "02 - OAuth 2.0 with PKCE",
      "item": [
        {
          "name": "Create authorization code",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identityBaseUrl}}/connect/authorize?client_id={{oauthClientId}}&response_type=code&redirect_uri={{oauthCallbackUrl}}&scope={{oauthScopes}}&code_challenge={{pkceChallenge}}&code_challenge_method=S256&state={{oauthState}}&nonce={{oauthNonce}}",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "connect",
                "authorize"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "{{oauthClientId}}"
                },
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{oauthCallbackUrl}}"
                },
                {
                  "key": "scope",
                  "value": "{{oauthScopes}}"
                },
                {
                  "key": "code_challenge",
                  "value": "{{pkceChallenge}}"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                },
                {
                  "key": "state",
                  "value": "{{oauthState}}"
                },
                {
                  "key": "nonce",
                  "value": "{{oauthNonce}}"
                }
              ]
            },
            "description": "Generates fresh PKCE values and captures the authorization code from the callback Location header. Redirect following is disabled intentionally. Run Sign in legacy local account first so Postman sends the IdentityServer cookie."
          },
          "response": [],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { Buffer } = require(\"buffer\");",
                  "const randomBytes = new Uint8Array(64);",
                  "crypto.getRandomValues(randomBytes);",
                  "const base64Url = value => Buffer.from(value)",
                  "  .toString(\"base64\")",
                  "  .replace(/\\+/g, \"-\")",
                  "  .replace(/\\//g, \"_\")",
                  "  .replace(/=+$/, \"\");",
                  "const verifier = base64Url(randomBytes);",
                  "const digest = await crypto.subtle.digest(\"SHA-256\", Buffer.from(verifier, \"ascii\"));",
                  "pm.environment.set(\"pkceVerifier\", verifier);",
                  "pm.environment.set(\"pkceChallenge\", base64Url(new Uint8Array(digest)));",
                  "pm.environment.set(\"oauthState\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"oauthNonce\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const querystring = require(\"querystring\");",
                  "pm.test(\"Authorization returned a callback redirect\", () => {",
                  "  pm.expect([302, 303]).to.include(pm.response.code);",
                  "});",
                  "const location = pm.response.headers.get(\"Location\");",
                  "if (!location) {",
                  "  throw new Error(\"No authorization callback was returned. Run the sign-in request first and keep the Postman cookie jar enabled.\");",
                  "}",
                  "const queryStart = location.indexOf(\"?\");",
                  "const fragmentStart = location.indexOf(\"#\", queryStart);",
                  "const query = queryStart >= 0",
                  "  ? location.slice(queryStart + 1, fragmentStart >= 0 ? fragmentStart : undefined)",
                  "  : \"\";",
                  "const parameters = querystring.parse(query);",
                  "const returnedState = parameters.state;",
                  "const code = parameters.code;",
                  "const error = parameters.error;",
                  "if (error) {",
                  "  throw new Error(`Authorization failed: ${error} ${parameters.error_description || \"\"}`);",
                  "}",
                  "pm.test(\"OAuth state matches\", () => pm.expect(returnedState).to.eql(pm.environment.get(\"oauthState\")));",
                  "pm.test(\"Authorization code was returned\", () => pm.expect(code).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"authorizationCode\", code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Exchange authorization code",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{oauthClientId}}",
                  "type": "text"
                },
                {
                  "key": "code",
                  "value": "{{authorizationCode}}",
                  "type": "text"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{oauthCallbackUrl}}",
                  "type": "text"
                },
                {
                  "key": "code_verifier",
                  "value": "{{pkceVerifier}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{identityBaseUrl}}/connect/token",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "connect",
                "token"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const key of [\"authorizationCode\", \"pkceVerifier\"]) {",
                  "  if (!pm.variables.get(key)) {",
                  "    throw new Error(`Run Create authorization code before exchanging the code; ${key} is missing.`);",
                  "  }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Authorization code was exchanged\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json();",
                  "  const activeAccount = pm.variables.get(\"activeAccount\");",
                  "  const accessTokenExpiresAt = String(Date.now() + token.expires_in * 1000);",
                  "  pm.environment.set(\"accessToken\", token.access_token);",
                  "  pm.environment.set(\"refreshToken\", token.refresh_token || \"\");",
                  "  pm.environment.set(\"idToken\", token.id_token || \"\");",
                  "  pm.environment.set(\"accessTokenExpiresAt\", accessTokenExpiresAt);",
                  "  pm.environment.set(`${activeAccount}AccessToken`, token.access_token);",
                  "  pm.environment.set(`${activeAccount}RefreshToken`, token.refresh_token || \"\");",
                  "  pm.environment.set(`${activeAccount}IdToken`, token.id_token || \"\");",
                  "  pm.environment.set(`${activeAccount}AccessTokenExpiresAt`, accessTokenExpiresAt);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get userinfo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identityBaseUrl}}/connect/userinfo",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "connect",
                "userinfo"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Access token resolves userinfo\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{oauthClientId}}",
                  "type": "text"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{identityBaseUrl}}/connect/token",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "connect",
                "token"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"refreshToken\")) {",
                  "  throw new Error(\"No refresh token is available. Exchange an authorization code with offline_access first.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refresh token was exchanged\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json();",
                  "  const activeAccount = pm.variables.get(\"activeAccount\");",
                  "  const accessTokenExpiresAt = String(Date.now() + token.expires_in * 1000);",
                  "  pm.environment.set(\"accessToken\", token.access_token);",
                  "  pm.environment.set(\"accessTokenExpiresAt\", accessTokenExpiresAt);",
                  "  pm.environment.set(`${activeAccount}AccessToken`, token.access_token);",
                  "  pm.environment.set(`${activeAccount}AccessTokenExpiresAt`, accessTokenExpiresAt);",
                  "  if (token.refresh_token) {",
                  "    pm.environment.set(\"refreshToken\", token.refresh_token);",
                  "    pm.environment.set(`${activeAccount}RefreshToken`, token.refresh_token);",
                  "  }",
                  "  if (token.id_token) {",
                  "    pm.environment.set(\"idToken\", token.id_token);",
                  "    pm.environment.set(`${activeAccount}IdToken`, token.id_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Application API",
      "description": "All requests in this folder require both the OAuth access token and the configured API-client header. The folder script validates and injects the access token, the API-client header and the Origin header when configured.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"accessToken\", \"identityBaseUrl\", \"apiAudience\", \"apiScope\", \"apiClientHeaderName\", \"apiClientKey\"]) {",
              "  if (!pm.variables.get(key)) {",
              "    throw new Error(`Set or obtain ${key} before calling the application API.`);",
              "  }",
              "}",
              "const { Buffer } = require(\"buffer\");",
              "const accessToken = pm.variables.get(\"accessToken\");",
              "const tokenParts = accessToken.split(\".\");",
              "if (tokenParts.length !== 3) {",
              "  throw new Error(\"accessToken is not a JWT. Run Exchange authorization code or Refresh access token; do not use idToken.\");",
              "}",
              "const decodeJwtPart = value => {",
              "  const normalized = value.replace(/-/g, \"+\").replace(/_/g, \"/\");",
              "  const padded = normalized.padEnd(Math.ceil(normalized.length / 4) * 4, \"=\");",
              "  return JSON.parse(Buffer.from(padded, \"base64\").toString(\"utf8\"));",
              "};",
              "let tokenHeader;",
              "let tokenClaims;",
              "try {",
              "  tokenHeader = decodeJwtPart(tokenParts[0]);",
              "  tokenClaims = decodeJwtPart(tokenParts[1]);",
              "} catch (error) {",
              "  throw new Error(`accessToken could not be decoded: ${error.message}`);",
              "}",
              "if (tokenHeader.typ !== \"at+jwt\") {",
              "  throw new Error(`Expected an at+jwt access token but received ${tokenHeader.typ || \"no typ\"}. Do not use idToken.`);",
              "}",
              "const expectedIssuer = `${pm.variables.get(\"identityBaseUrl\").replace(/\\/$/, \"\")}/`;",
              "if (tokenClaims.iss !== expectedIssuer) {",
              "  throw new Error(`Access token issuer ${tokenClaims.iss || \"is missing\"}; expected ${expectedIssuer}. Obtain a new token from the active environment.`);",
              "}",
              "const audiences = Array.isArray(tokenClaims.aud) ? tokenClaims.aud : [tokenClaims.aud];",
              "if (!audiences.includes(pm.variables.get(\"apiAudience\"))) {",
              "  throw new Error(`Access token audience does not include ${pm.variables.get(\"apiAudience\")}. Exchange a new authorization code with the configured API scope.`);",
              "}",
              "const scopes = typeof tokenClaims.scope === \"string\" ? tokenClaims.scope.split(/\\s+/).filter(Boolean) : [];",
              "if (!scopes.includes(pm.variables.get(\"apiScope\"))) {",
              "  throw new Error(`Access token scope does not include ${pm.variables.get(\"apiScope\")}. Exchange a new authorization code with the configured API scope.`);",
              "}",
              "const expiresAtMilliseconds = Number(tokenClaims.exp) * 1000;",
              "if (!Number.isFinite(expiresAtMilliseconds)) {",
              "  throw new Error(\"Access token has no valid exp claim. Exchange a new authorization code.\");",
              "}",
              "pm.environment.set(\"accessTokenExpiresAt\", String(expiresAtMilliseconds));",
              "pm.environment.set(`${pm.variables.get(\"activeAccount\")}AccessTokenExpiresAt`, String(expiresAtMilliseconds));",
              "if (Date.now() >= expiresAtMilliseconds) {",
              "  throw new Error(`Access token expired at ${new Date(expiresAtMilliseconds).toISOString()}. Run Refresh access token, or repeat the authorization-code flow.`);",
              "}",
              "pm.request.headers.upsert({ key: \"Authorization\", value: `Bearer ${accessToken}` });",
              "pm.request.headers.upsert({",
              "  key: pm.variables.get(\"apiClientHeaderName\"),",
              "  value: pm.variables.get(\"apiClientKey\")",
              "});",
              "const origin = pm.variables.get(\"apiClientOrigin\");",
              "if (origin) {",
              "  pm.request.headers.upsert({ key: \"Origin\", value: origin });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Account profile",
          "item": [
            {
              "name": "Provision application profile",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{apiBaseUrl}}/Account/create",
                  "host": [
                    "{{apiBaseUrl}}"
