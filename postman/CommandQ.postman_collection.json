{
  "info": {
    "_postman_id": "6271f85c-bfc9-45f2-bfbe-77026f499efc",
    "name": "CommandQ Backend",
    "description": "Backend requests for the standalone CommandQ IdentityServer and API. For the initial local flow, run Register legacy local account, Sign in, Create authorization code, Exchange authorization code, and Provision application profile in that order. Postman retains the IdentityServer cookie and the scripts store OAuth tokens only in the active environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const activeAccount = (pm.environment.get(\"activeAccount\") || \"tenant\").trim().toLowerCase();",
          "if (![\"admin\", \"tenant\"].includes(activeAccount)) {",
          "  throw new Error('activeAccount must be either \"admin\" or \"tenant\".');",
          "}",
          "",
          "const accountAliases = {",
          "  accountUsername: \"Username\",",
          "  accountEmail: \"Email\",",
          "  accountPassword: \"Password\",",
          "  identityUserId: \"IdentityUserId\",",
          "  accessToken: \"AccessToken\",",
          "  refreshToken: \"RefreshToken\",",
          "  idToken: \"IdToken\",",
          "  accessTokenExpiresAt: \"AccessTokenExpiresAt\"",
          "};",
          "",
          "for (const [alias, suffix] of Object.entries(accountAliases)) {",
          "  const profileKey = `${activeAccount}${suffix}`;",
          "  const profileValue = pm.environment.get(profileKey);",
          "  const value = profileValue === undefined ? pm.environment.get(alias) : profileValue;",
          "  pm.variables.set(alias, pm.variables.replaceIn(String(value || \"\")));",
          "}",
          "",
          "pm.variables.set(\"activeAccount\", activeAccount);"
        ]
      }
    }
  ],
  "item": [
    {
