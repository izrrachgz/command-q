    {
      "name": "99 - Session cleanup",
      "item": [
        {
          "name": "Revoke refresh token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{oauthClientId}}",
                  "type": "text"
                },
                {
                  "key": "token",
                  "value": "{{refreshToken}}",
                  "type": "text"
                },
                {
                  "key": "token_type_hint",
                  "value": "refresh_token",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{identityBaseUrl}}/connect/revoke",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "connect",
                "revoke"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Refresh token was revoked\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"refreshToken\", \"\");",
                  "  pm.environment.set(`${pm.variables.get(\"activeAccount\")}RefreshToken`, \"\");",
                  "}"
                ]
              }
            }
          ]
        },
