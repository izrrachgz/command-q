    {
      "name": "01 - Identity account",
      "item": [
        {
          "name": "Register legacy local account",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{accountUsername}}\",\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{identityBaseUrl}}/account/register",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "account",
                "register"
              ]
            },
            "description": "Creates the former local account values in ASP.NET Identity. A 400 response is expected when the account already exists. The account receives the default User role, matching the role in the original application seed."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const key of [\"accountUsername\", \"accountEmail\", \"accountPassword\"]) {",
                  "  if (!pm.variables.get(key)) {",
                  "    throw new Error(`Set ${key} in the active Postman environment before registering.`);",
                  "  }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Account was created or already exists\", () => {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const identityUserId = pm.response.json().id;",
                  "  const activeAccount = pm.variables.get(\"activeAccount\");",
                  "  pm.environment.set(\"identityUserId\", identityUserId);",
                  "  pm.environment.set(`${activeAccount}IdentityUserId`, identityUserId);",
                  "}"
                ]
              }
            }
          ]
        },
