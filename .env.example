# Example environment variable names for hosts that load .env files.
# The ASP.NET Core app does not load this file automatically.
# Prefer dotnet user-secrets for local development secrets.

ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__Engine=MsSql
ConnectionStrings__Db=Server=localhost;Database=CommandQ;User ID=commandq;Password=change-me;TrustServerCertificate=True;

Jwt__SecretKey=replace-with-at-least-32-random-bytes
Jwt__Issuer=localhost
Jwt__Audience=localhost
Jwt__MinutesToExpire=15
Jwt__ClockSkewMinutes=1
Jwt__RefreshTokenDays=1

Cookie__Name=CommandQ
Cookie__DaysToExpire=7

ApiClients__0__Name=Local Development
ApiClients__0__Id=replace-with-local-client-secret
ApiClients__0__Uri=https://localhost:4200

Migrations__RunOnStartup=true
HealthCheck__PublishOnStartup=false
