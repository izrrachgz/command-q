# Example environment variable names for hosts that load .env files.
# The ASP.NET Core app does not load this file automatically.
# Prefer dotnet user-secrets for local development secrets.

ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__Engine=PgSql
ConnectionStrings__Db=Host=localhost;Port=5432;Database=command_q;Username=postgres;Password=change-me;

Authentication__Authority=https://localhost:7125/
Authentication__Audience=command_q_api
Authentication__ApiScope=command_q_api
Authentication__RequireHttpsMetadata=true
Authentication__ClockSkewSeconds=60

ApiClients__0__Name=Local Development
ApiClients__0__Id=replace-with-local-client-secret
ApiClients__0__Uri=https://localhost:4200

Migrations__RunOnStartup=true
HealthCheck__PublishOnStartup=false

# Standalone IdentityServer process. These values are separate from Api settings.
# Set ConnectionStrings__Engine independently when the two processes use different engines.
ConnectionStrings__IdentityDb=Host=localhost;Port=5432;Database=command_q_identity;Username=postgres;Password=change-me;
OpenIddict__Issuer=https://localhost:7125/
OpenIddict__ApiScope=command_q_api
OpenIddict__AccessTokenMinutes=15
OpenIddict__RefreshTokenDays=14
OpenIddict__Certificates__UseDevelopmentCertificates=true

Identity__RequiredPasswordLength=12
Identity__MaxFailedAccessAttempts=5
Identity__LockoutMinutes=15
Identity__CookieHours=8
Identity__CookieName=CommandQ.Identity
Identity__AuthenticationPermitLimit=5
Identity__AuthenticationWindowSeconds=60
Identity__AuthenticationQueueLimit=0

ExternalProviders__Google__ClientId=
ExternalProviders__Google__ClientSecret=
ExternalProviders__Microsoft__ClientId=
ExternalProviders__Microsoft__ClientSecret=

DataProtection__ApplicationName=CommandQ.IdentityServer
DataProtection__KeysPath=
DataProtection__Certificate__Path=
DataProtection__Certificate__Password=
