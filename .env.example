# Example environment variable names for hosts that load .env files.
# The ASP.NET Core backend hosts do not load this file automatically.
# Prefer dotnet user-secrets for local development secrets.
# Every custom setting is prefixed by the host that owns it.

ASPNETCORE_ENVIRONMENT=Development

Api__Language=en-US
Api__ConnectionStrings__Engine=PgSql
Api__ConnectionStrings__Db=Host=localhost;Port=5432;Database=command-q;Username=postgres;Password=change-me;

Api__Authentication__Authority=https://localhost:7125/
Api__Authentication__Audience=command-q_api
Api__Authentication__ApiScope=command-q_api
Api__Authentication__RequireHttpsMetadata=true
Api__Authentication__ClockSkewSeconds=60

Api__ApiClients__0__Name=Local Development
Api__ApiClients__0__Id=replace-with-local-client-secret
Api__ApiClients__0__Uri=http://localhost:4200

Api__Migrations__RunOnStartup=true
Api__HealthCheck__PublishOnStartup=false
Api__EmailOutbox__Persistence__Engine=PgSql
Api__EmailOutbox__Persistence__ConnectionString=Host=localhost;Port=5432;Database=command-q;Username=postgres;Password=change-me;

# Standalone IdentityServer process. These values are separate from Api settings.
# Set IdentityServer__ConnectionStrings__Engine independently when the processes use different engines.
IdentityServer__ConnectionStrings__Engine=PgSql
IdentityServer__ConnectionStrings__IdentityDb=Host=localhost;Port=5432;Database=command-q_identity;Username=postgres;Password=change-me;
IdentityServer__OpenIddict__Issuer=https://localhost:7125/
IdentityServer__OpenIddict__ApiScope=command-q_api
IdentityServer__OpenIddict__AccessTokenMinutes=15
IdentityServer__OpenIddict__RefreshTokenDays=14
IdentityServer__OpenIddict__Certificates__UseDevelopmentCertificates=true

IdentityServer__Identity__RequiredPasswordLength=12
IdentityServer__Identity__MaxFailedAccessAttempts=5
IdentityServer__Identity__LockoutMinutes=15
IdentityServer__Identity__CookieHours=8
IdentityServer__Identity__CookieName=command-q.Identity
IdentityServer__Identity__AuthenticationPermitLimit=5
IdentityServer__Identity__AuthenticationWindowSeconds=60
IdentityServer__Identity__AuthenticationQueueLimit=0

IdentityServer__ExternalProviders__Google__ClientId=
IdentityServer__ExternalProviders__Google__ClientSecret=
IdentityServer__ExternalProviders__Microsoft__ClientId=
IdentityServer__ExternalProviders__Microsoft__ClientSecret=

IdentityServer__DataProtection__ApplicationName=command-q.IdentityServer
IdentityServer__DataProtection__KeysPath=
IdentityServer__DataProtection__Certificate__Path=
IdentityServer__DataProtection__Certificate__Password=

# Optional SMTP delivery settings for a host that references the Email project.
EmailWorker__Email__Enabled=false
EmailWorker__Email__Smtp__Host=
EmailWorker__Email__Smtp__Port=587
EmailWorker__Email__Smtp__Security=StartTls
EmailWorker__Email__Authentication__Type=Anonymous
EmailWorker__Email__Sender__Address=
EmailWorker__Email__Sender__Name=

# Standalone Email.Worker process and its independently migrated outbox schema.
EmailWorker__EmailOutbox__MaxAttempts=5
EmailWorker__EmailOutbox__BaseRetryDelaySeconds=30
EmailWorker__EmailOutbox__MaxRetryDelaySeconds=3600
EmailWorker__EmailOutbox__MaxErrorLength=2000
EmailWorker__EmailOutbox__MaxPayloadBytes=67108864
EmailWorker__EmailOutbox__Persistence__Engine=MsSql
EmailWorker__EmailOutbox__Persistence__ConnectionString=Server=localhost\SQLEXPRESS;Database=command-q;Trusted_Connection=True;TrustServerCertificate=True;
EmailWorker__Migrations__RunOnStartup=true
EmailWorker__Worker__Enabled=true
EmailWorker__Worker__BatchSize=10
EmailWorker__Worker__PollIntervalSeconds=5
EmailWorker__Worker__LeaseSeconds=1800
EmailWorker__Worker__ErrorDelaySeconds=30
